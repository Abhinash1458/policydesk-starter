{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "policydesk": {
      "root": ".",
      "entrypoint": "api/index.py",
      "buildCommand": "pip install -r requirements.txt"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": { "type": "service", "service": "policydesk" }
    }
  ],
  "env": { "APP_ENV": "vercel" },
  "git": { "deploymentEnabled": false }
}
